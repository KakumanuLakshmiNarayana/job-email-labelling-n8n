      }
    },
    {
      "parameters": {
        "inputText": "={{ $json.text }}",
        "categories": {
          "categories": [
            {
              "category": "Applications",
              "description": "Classify the following email into the \"Applications\" category only if it indicates that I have successfully applied for a job and the application is not made via LinkedIn. Look for phrases such as:  \"You have successfully applied\"  \"Application submitted\"  \"Thank you for applying\"  \"Your application has been received\""
            },
            {
              "category": "Interview",
              "description": "Classify the following email into the \"Interviews\" category only if it indicates that:  An interview has been scheduled  The sender is requesting to schedule an interview  The application has moved forward to the next step, such as screening or interview round  Look for phrases such as:  \"We'd like to schedule an interview\"  \"Your interview is scheduled\"  \"You have been shortlisted\"  \"Next steps in the hiring process\"  \"We are moving forward with your application\" or if it is Calendar event "
            },
            {
              "category": "Job alerts",
              "description": "Classify the following email into the \"Job Alerts\" category only if it contains job recommendations, suggestions, or listings that might match my profile.  Look for phrases such as:  \"Jobs you may be interested in\"  \"New jobs matching your profile\"  \"You might like these opportunities\"  \"We found some jobs for you\"  \"Based on your search, here are some roles\""
            },
            {
              "category": "Linked in Short applicaitions",
              "description": "Classify the following email into the \"Linked in Short applicaitions\" category only if it indicates that a job application was successfully submitted through LinkedIn.  Look for phrases such as:  \"You applied via LinkedIn\"  \"Your application has been submitted on LinkedIn\"  \"Thanks for applying through LinkedIn\"  \"You successfully applied using LinkedIn\""
            },
            {
              "category": "Rejections",
              "description": "Classify the following email into the \"Rejections\" category only if it clearly indicates that I have not been selected or my application was not successful.  Look for phrases such as:  \"We regret to inform you\"  \"You have not been selected\"  \"Not moving forward \"  \"Unfortunately, we have decided not to proceed\" \"Moving forward with other candidates\" \"Unfortunately\""
            },
            {
              "category": "Others",
              "description": "Classify the following email into the \"Others\" category only if it does not clearly belong to any of the following categories:  Applications   Linked in Short applicaitions Interviews  Job Alerts  Rejections"
            }
          ]
        },
        "options": {
          "systemPromptTemplate": "Please classify the text provided by the user into one of the following categories: {categories}, and use the provided formatting instructions below. Don't explain, and only output the json."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.textClassifier",
      "typeVersion": 1,
